{
  "name": "@relations-dil/relations",
  "version": "0.2.2",
  "description": "A simple, flexible DIL (data interface layer). Define models once, independent of backend; set the source at runtime.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/relations-dil/typescript-relations.git"
  },
  "homepage": "https://github.com/relations-dil/typescript-relations#readme",
  "bugs": {
    "url": "https://github.com/relations-dil/typescript-relations/issues"
  },
  "keywords": [
    "dil",
    "orm",
    "model",
    "relations",
    "database",
    "microservice"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./mock": {
      "types": "./dist/mock.d.ts",
      "default": "./dist/mock.js"
    },
    "./local": {
      "types": "./dist/local.d.ts",
      "default": "./dist/local.js"
    },
    "./rest": {
      "types": "./dist/rest.d.ts",
      "default": "./dist/rest.js"
    },
    "./overscore": {
      "types": "./dist/overscore.d.ts",
      "default": "./dist/overscore.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.map",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rm -rf dist dist-test",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "node --import tsx --test test/*.test.ts",
    "coverage": "tsc -p tsconfig.test.json --noEmit false --outDir dist-test && node --test --experimental-test-coverage --test-coverage-exclude='dist-test/test/**' --test-reporter=spec dist-test/test/*.test.js",
    "lint": "npm run typecheck && eslint src test",
    "example": "npm run build && for e in example/*.mjs; do echo \"== $e\"; node $e; done",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.0.0",
    "@unum-pillars/uikit": "^0.1.0",
    "esbuild": "^0.25.12",
    "eslint": "^9.39.5",
    "jsdom": "^24.1.3",
    "tsx": "^4.23.15",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.71.0"
  }
}
